# Which speech-to-speech backend to use.
# "gemini" — Google Gemini Live (default, broadly available)
# "openai" — OpenAI Realtime API
LLM_BACKEND=gemini

# --- Gemini Live (LLM_BACKEND=gemini) -----------------------------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Pick a Gemini Live model. Two ways:
#
# 1. GEMINI_NATIVE_AUDIO — boolean toggle (recommended):
#      true  (default) → models/gemini-2.5-flash-native-audio-latest
#                        (best voice quality, lower latency; needs key access)
#      false           → models/gemini-live-2.5-flash-preview
#                        (broadly available, slightly older audio quality)
GEMINI_NATIVE_AUDIO=true
#
# 2. GEMINI_LIVE_MODEL — explicit override (wins over GEMINI_NATIVE_AUDIO).
#    Use this for pinned snapshots or early-access models. Leave blank to
#    let GEMINI_NATIVE_AUDIO decide.
#    Hit GET http://localhost:7860/api/diag to see which models your key can use.
#      models/gemini-2.5-flash-native-audio-latest          (default when toggle=true)
#      models/gemini-2.5-flash-native-audio-preview-09-2025 (pinned Sep 2025 snapshot)
#      models/gemini-live-2.5-flash-preview                 (default when toggle=false)
#      models/gemini-3.1-flash-live-preview                 (early access only)
GEMINI_LIVE_MODEL=

# --- OpenAI Realtime (LLM_BACKEND=openai) -------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — override the OpenAI Realtime model. Leave unset to use the default.
#   gpt-4o-mini-realtime-preview   (default — cheapest realtime model)
#   gpt-4o-realtime-preview        (better quality, ~3-4x cost)
#   gpt-realtime-1.5               (newest, may need account access)
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview-2024-12-17

# --- Image cards (optional) ---------------------------------------------
# Google Programmable Search for richer image cards. Without these,
# Wikipedia is used as a fallback (no key needed).
# Set up at https://programmablesearchengine.google.com/ — turn ON
# "Search the entire web" and "Image search".
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=

HOST=0.0.0.0
PORT=7860
